# Copy to .env and fill in for your environment. Never commit the real .env file.

# --- Persistence ---
# "sqlite" is the active, verified backend for the demo stack (finpilot/core/db.py).
# "postgres" targets app/db_pg, which is written but NOT wired into app/services yet --
# switching this alone does nothing; see docs/ARCHITECTURE.md before attempting it.
PERSISTENCE_BACKEND=sqlite
# Only read if PERSISTENCE_BACKEND=postgres:
# DATABASE_URL=postgresql://finpilot:finpilot@postgres:5432/finpilot

# --- AI provider ---
# AI_PROVIDER=demo runs DeterministicDemoAgent (no external calls, always available).
# AI_PROVIDER=anthropic activates ClaudeAgentProvider -- requires ANTHROPIC_API_KEY and
# has NOT been verified end-to-end in this build (no network in the build sandbox).
AI_PROVIDER=demo
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# --- App ---
DEMO_MODE=true
SECRET_KEY=change-me-in-any-real-deployment

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Docker only (set directly in docker-compose.yml, not usually needed in .env) ---
# SQLITE_PATH=/app/data/finpilot.db   # explicit, sidesteps a container path-depth bug -- see docs/VERIFICATION_MATRIX.md
# INTERNAL_API_URL=http://backend:8000/api/v1   # server-rendered pages inside the frontend container
